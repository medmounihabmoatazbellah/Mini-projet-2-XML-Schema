<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <xsd:element name="nom" type="xsd:string"/>
    <xsd:element name="real-estate">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="agencies">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="agency" type="agency" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="owners">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="owner" type="owner" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="properties">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="property" type="property" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
                <xsd:element name="flats">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="flat" type="flat" maxOccurs="unbounded"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <xsd:complexType name="agency">
        <xsd:sequence>
            <xsd:element name="nom" type="xsd:string"/>
            <xsd:element name="address-electronique" type="xsd:string"/>
            <xsd:element name="numero-telephone" type="xsd:string"/>
        </xsd:sequence>
    </xsd:complexType>
    <xsd:complexType name="owner">
        <xsd:sequence>
            <xsd:element name="nom" type="xsd:string"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:string" use="required"/>
    </xsd:complexType>
    <xsd:complexType name="property">
        <xsd:sequence>
            <xsd:element name="nom" type="xsd:string"/>
            <xsd:element name="nombre-appartements" type="xsd:string"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:string" use="required"/>
        <xsd:attribute name="owner-id" type="xsd:string" use="optional"/>
    </xsd:complexType>
    <xsd:complexType name="flat">
        <xsd:sequence>
            <xsd:element name="nom" type="xsd:string"/>
            <xsd:element name="description" type="xsd:string"/>
            <xsd:element name="tarif" type="xsd:string"/>
        </xsd:sequence>
        <xsd:attribute name="id" type="xsd:string" use="required"/>
        <xsd:attribute name="property-id" type="xsd:string" use="required"/>
        <xsd:attribute name="niveau-confort" type="xsd:string" use="required"/>
        <xsd:attribute name="date-mise-ligne" type="xsd:string" use="optional"/>
    </xsd:complexType>
</xsd:schema>